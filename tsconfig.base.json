{
    "compilerOptions": {
        "target": "ES2022",
        "module": "ESNext",
        "moduleResolution": "bundler",
        "declaration": true,
        "declarationMap": true,
        "sourceMap": true,
        "composite": true,
        "esModuleInterop": true,
        "skipLibCheck": true,
        "strict": true,
        "forceConsistentCasingInFileNames": true,
        "resolveJsonModule": true,
        "isolatedModules": false,
        "jsx": "preserve",
        "baseUrl": "."
    },
    "include": [
        "packages/**/*",
        "apps/**/*"
    ],
    "exclude": [
        "node_modules",
        "**/dist",
        "**/build",
        "**/*.tsbuildinfo"
    ]
}