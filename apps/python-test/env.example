# FlowAI SaaS Agent Configuration
# Copy to .env and fill in your values

# MCP Server (GenUI Protocol)
GENUI_MCP_BASE_URL=http://localhost:4000

# LLM Provider (choose one)
# OpenAI
OPENAI_API_KEY=sk-your-openai-key
OPENAI_MODEL=gpt-4o

# Anthropic
ANTHROPIC_API_KEY=sk-ant-your-anthropic-key
ANTHROPIC_MODEL=claude-sonnet-4-20250514

# Default provider: "openai" or "anthropic"
GENUI_LLM_PROVIDER=openai

# Agent settings
GENUI_MAX_TOKENS=4096
GENUI_TEMPERATURE=0.2

# API Server
GENUI_API_HOST=0.0.0.0
GENUI_API_PORT=8000
